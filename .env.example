# ---- ofw-mcp-server configuration (copy to .env and fill in your own values) ----
# Nothing here is committed. Each user configures their OWN keys and calendars.

# --- OFW (no password is ever stored; auth is your own browser session) ---
OFW_BASE_URL=https://ofw.ourfamilywizard.com
OFW_APP_HOME_PATH=/app/home
OFW_LOGIN_PATH=/app/login

# --- Google (Calendar + Sheets + Gmail drafts) ---
# OAuth client downloaded from Google Cloud Console (Desktop app credentials).
GOOGLE_CREDENTIALS_FILE=./credentials.json
GOOGLE_TOKEN_FILE=./token.json
# Target parenting calendar (your own OFW mirror calendar id):
GCAL_TARGET_CALENDAR_ID=
# Extra calendars to watch for auto-detection (comma-separated ids), optional:
GCAL_WATCH_CALENDAR_IDS=

# --- Google Sheet notes tracker ---
GSHEET_NOTES_ID=
# The sheet/workbook that mirrors OFW notes. Tabs: Messages, Calendar, Expenses,
# ActionItems, InfoBank, SyncLog (see templates/).

# --- Gmail (drafts only; never auto-sends) ---
GMAIL_ADDRESS=

# --- Social auto-detection (all optional, opt-in per channel) ---
# Only used to correlate YOUR OWN activity. Leave blank to disable a channel.
SOCIAL_ENABLED=false
# e.g. tokens/handles for channels you opt in to:
# X_BEARER_TOKEN=
# INSTAGRAM_TOKEN=

# --- Sync safety ---
SYNC_MODE=dry_run          # dry_run (default, safe) or live
SYNC_STATE_FILE=./state.json
